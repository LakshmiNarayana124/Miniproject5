# ── IntelliWatch Frontend — Environment Variables ────────────────────────────
#
# Copy this file to .env.local and edit for your deployment target.
#
# ── LOCAL DEVELOPMENT (default — plain HTTP, no changes needed) ──────────────
# VITE_API_URL=http://localhost:8000
#
# ── LOCAL DEVELOPMENT WITH HTTPS ─────────────────────────────────────────────
# Run the dev server with:  npm run dev:https
# Vite will generate a self-signed certificate automatically.
# Set the backend URL to HTTPS as well (use a reverse proxy or uvicorn SSL):
# VITE_API_URL=https://localhost:8000
#
# ── LAN / MOBILE TESTING (same Wi-Fi network) ─────────────────────────────────
# Run:  npm run dev:network   (exposes on all interfaces)
# Use your PC's local IP so phones and tablets can reach the frontend:
# VITE_API_URL=http://192.168.1.42:8000
# Open https://192.168.1.42:5173 on the mobile device.
#
# ── CLOUD / PRODUCTION (HTTPS via reverse proxy) ─────────────────────────────
# Put Nginx / Caddy in front of both the frontend (port 443) and
# the FastAPI backend (proxied at /api or a subdomain).
# The frontend derives WebSocket URLs automatically:
#   http://  →  ws://
#   https:// →  wss://
# Example:
# VITE_API_URL=https://api.intelliwatch.example.com
#
# ── HTTPS ON THE BACKEND (uvicorn native SSL) ─────────────────────────────────
# Generate a self-signed cert (dev/LAN only):
#   openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
# Start uvicorn with:
#   uvicorn server:app --ssl-keyfile key.pem --ssl-certfile cert.pem --host 0.0.0.0 --port 8000
# Then set:
# VITE_API_URL=https://192.168.1.42:8000

VITE_API_URL=http://localhost:8000
