# ── IntelliWatch Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and edit before running the server.
# Load it with: set -a; source .env; set +a   (Linux/macOS)
# or:           Get-Content .env | ForEach-Object { ... }  (Windows PowerShell)

# ── REQUIRED ──────────────────────────────────────────────────────────────────
INTELLIWATCH_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed by CORS.
# For HTTPS deployments include both http and https origins as needed.
# Examples:
#   INTELLIWATCH_CORS_ORIGINS=https://intelliwatch.example.com
#   INTELLIWATCH_CORS_ORIGINS=http://192.168.1.42:5173,https://192.168.1.42:5173
INTELLIWATCH_CORS_ORIGINS=

# Database file path (default: Backend/database/intelliwatch.db)
# INTELLIWATCH_DB_PATH=/data/intelliwatch.db

# Server host / port
# INTELLIWATCH_HOST=0.0.0.0
# INTELLIWATCH_PORT=8000

# ── HTTPS / TLS (native uvicorn SSL — dev/LAN only) ──────────────────────────
# For production use a reverse proxy (Nginx, Caddy) instead of native SSL.
#
# Step 1 – generate a self-signed certificate (valid 365 days):
#   openssl req -x509 -newkey rsa:4096 \
#     -keyout key.pem -out cert.pem -days 365 -nodes \
#     -subj "/CN=intelliwatch-local"
#
# Step 2 – start the server with SSL:
#   uvicorn server:app \
#     --ssl-keyfile key.pem \
#     --ssl-certfile cert.pem \
#     --host 0.0.0.0 \
#     --port 8000
#
# Step 3 – update the frontend .env.local:
#   VITE_API_URL=https://<your-ip-or-domain>:8000
#
# Step 4 – add the HTTPS frontend origin to CORS:
#   INTELLIWATCH_CORS_ORIGINS=https://<your-ip-or-domain>:5173
#
# INTELLIWATCH_SSL_KEYFILE=key.pem
# INTELLIWATCH_SSL_CERTFILE=cert.pem
